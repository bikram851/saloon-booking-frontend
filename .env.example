# Glow & Grace Frontend — Environment Variables

# Firebase Cloud Functions / REST API URL
VITE_API_URL=https://us-central1-glow-grace-saloon.cloudfunctions.net/api

# For local development with Firebase Functions emulator:
# VITE_API_URL=http://localhost:5001/glow-grace-saloon/us-central1/api
# Or standalone Express server:
# VITE_API_URL=http://localhost:8080/api

# Firebase Web App Credentials (from Firebase Console -> Project Settings)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=glow-grace-saloon.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=glow-grace-saloon
VITE_FIREBASE_STORAGE_BUCKET=glow-grace-saloon.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
